# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://codedoc:codedoc@localhost:5433/codedoc?schema=public"

# Create a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=""

# Central model overrides (optional).
OPENAI_CHAT_MODEL="gpt-4.1-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Local directory for shallow repository clones.
REPOSITORY_STORAGE_PATH=".data/repositories"
